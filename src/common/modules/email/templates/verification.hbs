<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Verify Your Email</title>

    <style>
      /* Base email styles */
      body {
        margin: 0;
        padding: 24px;
        background-color: #f4f5f7;
        font-family: Arial, sans-serif;
        color: #333333;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        padding: 40px 32px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }

      .header {
        margin: 0 0 24px;
        text-align: center;
        color: #111827;
        font-size: 24px;
      }

      .content {
        font-size: 15px;
        line-height: 1.6;
      }

      .button-container {
        margin: 32px 0;
        text-align: center;
      }

      .button {
        display: inline-block;
        padding: 13px 28px;
        background-color: #0056b3;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
      }

      .note {
        margin-top: 24px;
        font-size: 13px;
        color: #6b7280;
      }

      .footer {
        margin-top: 32px;
        padding-top: 16px;
        border-top: 1px solid #eeeeee;
        text-align: center;
        font-size: 12px;
        color: #9ca3af;
      }
    </style>
  </head>

  <body>
    <div class='container'>
      <h2 class='header'>Welcome to Ezay Cart!</h2>

      <div class='content'>
        <p>Hello <strong>{{username}}</strong>,</p>

        <p>
          Thank you for registering with Ezay Cart. Please verify your email
          address by clicking the button below.
        </p>

        <div class='button-container'>
          <a href='{{verificationUrl}}' class='button'>
            Verify Email
          </a>
        </div>

        <p class='note'>
          If you did not create an account with Ezay Cart, you can safely ignore
          this email.
        </p>
      </div>

      <div class='footer'>
        <p>&copy; {{year}} Ezay Cart. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>